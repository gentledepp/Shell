<Page xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ShellExample.Views.NavigateAndWaitCancelledPage"
             NavigationBar.Header="NavigateAndWait Cancelled">
	<NavigationBar.HeaderIcon>
		<i:Icon Value="fa-solid fa-circle-xmark" />
	</NavigationBar.HeaderIcon>
	
	<StackPanel HorizontalAlignment="Center"
	            VerticalAlignment="Center"
	            Spacing="20">
		<TextBlock Text="NavigateAndWait Cancelled Example" 
		           FontSize="24" 
		           FontWeight="Bold" 
		           HorizontalAlignment="Center" />
		
		<TextBlock Text="This page demonstrates nested NavigateAndWaitAsync cancellation" 
		           FontSize="14" 
		           HorizontalAlignment="Center" 
		           TextWrapping="Wrap" />
		
		<StackPanel Spacing="10">
			<TextBlock Text="During InitializeAsync, this page will:" 
			           FontSize="12" 
			           HorizontalAlignment="Center" 
			           TextWrapping="Wrap" />
			
			<TextBlock Text="1. Call NavigateAndWaitAsync to navigate to a helper page" 
			           FontSize="11" 
			           HorizontalAlignment="Center" 
			           TextWrapping="Wrap" 
			           Foreground="Gray" />
			
			<TextBlock Text="2. The helper page will call Navigator.BackAsync() to cancel the chain" 
			           FontSize="11" 
			           HorizontalAlignment="Center" 
			           TextWrapping="Wrap" 
			           Foreground="Gray" />
			
			<TextBlock Text="3. This should cancel the entire navigation chain" 
			           FontSize="11" 
			           HorizontalAlignment="Center" 
			           TextWrapping="Wrap" 
			           Foreground="Gray" />
		</StackPanel>
		
		<TextBlock Text="You should never see this page!" 
		           FontSize="16" 
		           HorizontalAlignment="Center" 
		           Foreground="Red" 
		           FontWeight="Bold" />
		
	</StackPanel>
</Page>