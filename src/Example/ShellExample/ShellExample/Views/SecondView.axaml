<shell:Page xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:shell="clr-namespace:AvaloniaInside.Shell;assembly=AvaloniaInside.Shell"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="450"
             x:Class="ShellExample.Views.SecondView"
             shell:NavigationBar.Header="Second view"
             shell:ShellView.OverrideSideMenuBehave="{Binding SelectedBehavior}">
    <shell:ShellView.OverrideSideMenu>
        <StackPanel Spacing="10" Margin="20">
            <TextBlock Text="Custom Side Menu"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

            <!-- Back button that uses the ShellView's BackCommand -->
            <Button Content="← Back"
                    HorizontalAlignment="Stretch"
                    Command="{Binding $parent[shell:ShellView].BackCommand}" />

            <Separator Margin="0,10"/>

            <TextBlock Text="This is a custom side menu!"
                       TextWrapping="Wrap"/>

            <TextBlock Text="You can put any content here - navigation controls, filters, settings, etc."
                       TextWrapping="Wrap"
                       Margin="0,10,0,0"
                       Foreground="Gray"
                       FontSize="12"/>
            
            <TextBlock Text="{Binding Title, TargetNullValue='null', FallbackValue='fallback'}"
                       TextWrapping="Wrap"
                       Margin="0,10,0,0"
                       Foreground="Gray"/>
        </StackPanel>
    </shell:ShellView.OverrideSideMenu>

    <StackPanel Margin="20" Spacing="10">
        <TextBlock Text="Welcome to Second View!" FontSize="24" FontWeight="Bold"/>

        <TextBlock Text="This page demonstrates a custom side menu override." TextWrapping="Wrap"/>

        <TextBlock Text="Change the side menu behavior to see how it affects the display and buttons:"
                   TextWrapping="Wrap"
                   Margin="0,20,0,5"
                   FontWeight="SemiBold"/>

        <ComboBox ItemsSource="{Binding BehaviorOptions}"
                  SelectedItem="{Binding SelectedBehavior}"
                  HorizontalAlignment="Stretch"
                  Margin="0,0,0,10">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <Border Background="#10000000" Padding="10" CornerRadius="5">
            <StackPanel Spacing="5">
                <TextBlock Text="Behavior descriptions:" FontWeight="SemiBold"/>
                <TextBlock Text="• (null): Uses responsive behavior (Keep on large, Default on medium/small)"
                           TextWrapping="Wrap" FontSize="11"/>
                <TextBlock Text="• Default: Hamburger toggles menu, respects screen size display mode"
                           TextWrapping="Wrap" FontSize="11"/>
                <TextBlock Text="• Keep: Menu always visible, no hamburger button"
                           TextWrapping="Wrap" FontSize="11"/>
                <TextBlock Text="• Closed: Menu hidden but available, hamburger opens it"
                           TextWrapping="Wrap" FontSize="11"/>
                <TextBlock Text="• Removed: Menu completely hidden, back button shows"
                           TextWrapping="Wrap" FontSize="11"/>
            </StackPanel>
        </Border>
    </StackPanel>
</shell:Page>

